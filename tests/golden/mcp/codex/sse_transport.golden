        ),
        files: [
            Missing {
                path: "[ROOT]/.codex/config.toml",
            },
            Missing {
                path: "[ROOT]/.codex/.agent-config-mcp.json",
            },
        ],
        warnings: [],
    },
)
validation:
Ok(
    ValidationReport {
        target: Mcp {
            integration_id: "codex",
            scope: Local(
                "[ROOT]",
            ),
            name: "golden-server",
            owner: "golden-owner",
        },
        ok: true,
        issues: [],
        suggested_actions: [
            NoAction,
        ],
    },
)

