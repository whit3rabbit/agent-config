surface: hooks
agent: antigravitycli
scenario: uninstall_one_preserves_sibling

uninstall_result:
Ok(
    UninstallReport {
        removed: [],
        patched: [
            "[ROOT]/.agents/hooks.json",
            "[ROOT]/AGENTS.md",
        ],
        restored: [],
        not_installed: false,
    },
)
status:
Ok(
    StatusReport {
        target: Hook {
            tag: "golden-hook",
        },
        status: Absent,
        config_path: Some(
            "[ROOT]/AGENTS.md",
        ),
        ledger_path: None,
        files: [
            Exists {
                path: "[ROOT]/AGENTS.md",
            },
        ],
        warnings: [],
    },
)
validation:
Ok(
    ValidationReport {
        target: Hook {
            integration_id: "antigravitycli",
            scope: Local(
                "[ROOT]",
            ),
            tag: "golden-hook",
        },
        ok: false,
        issues: [
            BackupCollision {
                path: "[ROOT]/AGENTS.md.bak",
            },
        ],
        suggested_actions: [
            RestoreBackup,
        ],
    },
)

